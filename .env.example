# Configuration — copy to `.env.local` and fill in. `.env.local` is gitignored.

# --- Database (Neon Postgres + PostGIS) -------------------------------------
# Neon dashboard → your project → Connect. Use the POOLED string for the app
# (host contains "-pooler") and the direct string for migrations.
DATABASE_URL=postgres://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=postgres://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# --- GitHub sign-in (Auth.js) — optional -----------------------------------
# Without these the app runs with anonymous per-browser operator ids.
# AUTH_SECRET: `npx auth secret` or `openssl rand -base64 33`.
# GitHub → Settings → Developer settings → OAuth Apps; callback URL:
#   https://<your-domain>/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- AI briefs — optional --------------------------------------------------
GEMINI_API_KEY=
